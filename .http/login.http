# @name login
POST {{$dotenv pingFed_tokenURL}}
Content-Type: application/x-www-form-urlencoded
Accept:  application/json

grant_type=client_credentials
&client_id={{$dotenv pingFed_clientId}}
&client_secret={{$dotenv pingFed_clientSecret}}
&scope={{$dotenv pingFed_scope}}

## returns a json object with the following shape
## {
##   access_token: string;
##   token_type: string;
##   expires_in: number;
## }